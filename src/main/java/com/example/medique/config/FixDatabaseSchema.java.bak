package com.example.medique.config;

import jakarta.annotation.PostConstruct;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.context.annotation.Configuration;
import org.springframework.jdbc.core.JdbcTemplate;
import org.springframework.transaction.annotation.Transactional;

@Configuration
public class FixDatabaseSchema {

    @Autowired
    private JdbcTemplate jdbcTemplate;
    
    private static boolean executed = false;

    @PostConstruct
    @Transactional
    public void fixAppointmentsTable() {
        if (executed) {
            return;
        }
        
        try {
            // Check if appointments table exists
            try {
                jdbcTemplate.queryForObject(
                    "SELECT COUNT(*) FROM information_schema.columns " +
                    "WHERE table_schema = 'new-hsrole_db' " +
                    "AND table_name = 'appointments' " +
                    "AND column_name = 'appointment_time'",
                    Integer.class
                );
                
                // If old column exists, drop and recreate table
                System.out.println("🔧 Old appointment_time column found. Fixing schema...");
                
                jdbcTemplate.execute("DROP TABLE IF EXISTS appointments");
                
                jdbcTemplate.execute(
                    "CREATE TABLE appointments (" +
                    "id BIGINT AUTO_INCREMENT PRIMARY KEY, " +
                    "patient_id BIGINT NOT NULL, " +
                    "doctor_id BIGINT NOT NULL, " +
                    "appointment_date DATE NOT NULL, " +
                    "time_slot VARCHAR(255) NOT NULL, " +
                    "status VARCHAR(255) NOT NULL, " +
                    "created_at DATETIME(6) NOT NULL, " +
                    "updated_at DATETIME(6), " +
                    "FOREIGN KEY (patient_id) REFERENCES users(id), " +
                    "FOREIGN KEY (doctor_id) REFERENCES users(id)" +
                    ") ENGINE=InnoDB"
                );
                
                System.out.println("✅ Appointments table recreated successfully with time_slot column!");
                
            } catch (Exception e) {
                System.out.println("✅ Schema already correct or table doesn't exist yet.");
            }
            
            executed = true;
            
        } catch (Exception e) {
            System.err.println("⚠️ Error checking/fixing appointments table: " + e.getMessage());
            e.printStackTrace();
        }
    }
}
